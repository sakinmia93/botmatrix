# ============================================================
# BOT MATRIX — environment template for Railway / production
# Set these in Railway Variables UI. Do NOT commit a real .env.
# Never put bot tokens, DB passwords or SECRET_KEY in git.
# ============================================================

# Required in production (32+ chars). openssl rand -hex 32
SECRET_KEY=

# Public site URL (no trailing slash)
# Example: https://your-app.up.railway.app
BASE_URL=

CONNECT_BOT_TOKEN=
ADMIN_EMAILS=
ADMIN_CONTACT_URL=

# ---- Postgres (Railway plugin)
# DATABASE_URL=postgresql://postgres:****@postgres.railway.internal:5432/railway
DATABASE_URL=

# ---- Redis (Railway plugin) — recommended for cache
# REDIS_URL=redis://default:****@redis.railway.internal:6379
REDIS_URL=

# Mount a volume at /app/storage for platform app.db + uploads

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
REQUIRE_EMAIL_OTP=0

TURNSTILE_ENABLED=0
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

RATE_LIMITS=1
API_PORT=5001
NODE_ENV=production
